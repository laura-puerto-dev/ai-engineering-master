# Plantilla de configuración: copia este archivo a .env en tu entorno local.
# Las opciones locales no necesitan claves. Nunca rellenes esta plantilla pública
# con credenciales: .env permanece fuera de Git.

# ── Modelo remoto (S8) ────────────────────────────────────────────────────────
# Ruta que usan scripts/demo.py y scripts/evaluar_remotos.py cuando no indicas
# --proveedor. Valores: anthropic | openai | openrouter | compatible | gemini |
# local | google. La ruta del curso es Claude Haiku 5.5 por la API de Anthropic.
LLM_PROVIDER=anthropic
# ID del modelo en esa ruta. Cada proveedor usa su propio formato de ID, p. ej.:
#   anthropic   claude-haiku-5-5
#   openai      el ID que muestre tu cuenta de OpenAI
#   openrouter  proveedor/modelo exacto de openrouter.ai/models, p. ej.
#               anthropic/claude-haiku-5.5, z-ai/glm-5.3, moonshotai/kimi-k3, openai/gpt-6-luna
#   compatible  el ID del servidor elegido (Groq, Mistral, Ollama, vLLM…)
#   gemini      gemini-3.1-flash-lite
LLM_MODEL=claude-haiku-5-5
# Tarifa en USD por millón de tokens del modelo de LLM_MODEL, para calcular coste.
# Valores publicados por Anthropic para claude-haiku-5-5 con prompts de hasta
# 100.000 tokens (octubre de 2026). Si cambias de modelo, pon su tarifa o déjalo
# vacío: sin tarifa, el coste se registra como null (no medido), nunca como 0.
# OpenRouter no la usa: informa el importe real de cada consulta.
LLM_PRECIO_ENTRADA_USD_MTOK=0.10
LLM_PRECIO_SALIDA_USD_MTOK=0.50
# Opcional. Temperatura para la ruta de LLM_PROVIDER: vacío usa el valor del
# adaptador; "omitir" no la envía. Claude Haiku 5.5 solo admite el predeterminado.
LLM_TEMPERATURE=
# Opcional. Campos JSON extra para la ruta de LLM_PROVIDER, mezclados con la
# petición. null retira un campo. Ejemplos:
#   OpenAI con razonamiento:  {"reasoning_effort": "minimal"}
#   Claude Opus/Sonnet 5.5:   {"thinking": {"type": "adaptive"}, "output_config": {"effort": "low"}}
#   Gemini Pro:               {"generationConfig": {"thinkingConfig": {"thinkingLevel": "LOW"}}}
LLM_EXTRA_BODY=

# ── Claves por proveedor: rellena solo la de la ruta que uses ─────────────────
# Anthropic (Messages API, SDK oficial). Vacío: esa ruta se detiene.
ANTHROPIC_API_KEY=
# OpenAI (Chat Completions). OPENAI_BASE_URL solo si usas otra URL compatible.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter: una clave para cientos de modelos (Claude, GPT, GLM, Kimi, Qwen…).
OPENROUTER_API_KEY=
# Gemini API de Google con clave (Google AI Studio). No sirve para el ajuste.
GEMINI_API_KEY=
# Cualquier API compatible con Chat Completions: URL base y clave si la pide.
# Remota: https obligatorio. Local: p. ej. http://localhost:11434/v1 (Ollama).
COMPAT_BASE_URL=
COMPAT_API_KEY=
# Nombre del límite de salida si el servidor no acepta max_tokens.
# COMPAT_TOKEN_FIELD=max_completion_tokens

# ── Modelo abierto en local (S7) ──────────────────────────────────────────────
# Modelo original de Transformers que utilizan entrenamiento e inferencia Qwen.
OPEN_MODEL_ID=Qwen/Qwen3-0.6B
# Commit exacto del Hub: fija pesos y tokenizer para las tres condiciones.
# El manifiesto congelado también lo registra y rechaza un cambio incompatible.
OPEN_MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
# API compatible de LM Studio; /models descubre IDs y /chat/completions consulta.
# El comparador propio original/LoRA utiliza otro servidor: localhost:1235/v1.
LOCAL_BASE_URL=http://localhost:1234/v1
# Opcional: descomenta y usa el ID real de tu servidor LM Studio.
# LOCAL_MODEL_ID=ID_REAL

# ── Google Cloud: Gemini base/ajustado y ajuste gestionado (S8) ───────────────
# Proyecto explícito del laboratorio. Vacío: no se crea cliente ni se usa otro
# proyecto por defecto de las credenciales ADC.
GOOGLE_CLOUD_PROJECT=
# Proyecto al que ADC atribuye cuota/consumo. Configúralo con el mismo ID del
# laboratorio; así no cambias el archivo ADC global del equipo para otros repos.
GOOGLE_CLOUD_QUOTA_PROJECT=
# Ubicación de inferencia Google. Es distinta de europe-west4, región del tuning.
# eu y us son multirregiones. El ajustado de europe-west4 se sirve por eu;
# el de us-central1, por us. El estado del trabajo conserva la región de ajuste.
GEMINI_SERVING_LOCATION=eu
# Bucket existente del laboratorio para los JSONL de train y validación.
# Convertir el test localmente no significa subirlo al entrenamiento.
TUNING_BUCKET=
# Tuning fija europe-west4; presupuesto/estimación se pasan por CLI, no por .env.
# El destino de publicación HF se indica con --repo.
# HF_TOKEN y credenciales Google se configuran fuera del repositorio.
