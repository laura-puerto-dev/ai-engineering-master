# PostgreSQL Docker configuration
POSTGRES_DB=policy_consultant
POSTGRES_USER=policy_consultant_admin
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

# Application database connection
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Password for the restricted, RLS-bound policy_app role. Must be
# non-empty. Used only once, when policy_app is first created (see
# migrations/002_security.sql) — changing this value afterwards does
# NOT change the role's actual password. To rotate it, connect as
# policy_consultant_admin and run manually:
#   ALTER ROLE policy_app WITH PASSWORD 'new-value';
POLICY_APP_PASSWORD=local_dev_password_app

# Device for local BGE-M3 inference in scripts/sync_corpus.py. Defaults to
# "cpu" (works on any machine); set to "cuda" to use an NVIDIA GPU.
EMBEDDING_DEVICE=cpu

# Required for generation.ClaudeAnswerGenerator (Etapa 8) — unless you use an
# `ant auth login` profile instead (verified directly against the installed
# SDK: anthropic.Anthropic() falls back to the active on-disk profile when no
# key/token env var is set). anthropic.Anthropic() reads this from the real
# process environment, not from this file — whatever script constructs
# ClaudeAnswerGenerator must call load_dotenv() itself first, same as every
# other script in this project. Never commit a real key here.
ANTHROPIC_API_KEY=
